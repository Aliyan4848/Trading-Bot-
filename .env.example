# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored — NEVER commit real credentials.
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# ---------------------------------------------------------------------------

# ---- MetaTrader 5 terminal (required for `broker.mode: mt5`) ----
# Use an INVESTOR (read-only) password while you are validating the bot.
MT5_LOGIN=12345678
MT5_PASSWORD=your-password-here
MT5_SERVER=YourBroker-Demo
# Optional: full path to terminal64.exe if it is not auto-detected
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# ---- Live trading safety switch -------------------------------------------
# Live order routing stays disabled unless BOTH this is "yes" AND the CLI is
# invoked with `--live`. Paper trading is the default everywhere.
SCALPER_ALLOW_LIVE=no

# ---- Optional: Telegram alerts --------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
