# =============================================================================
# AI Trading Bot — environment variable template
# Copy to .env and fill in. NEVER commit a real .env file.
# Placeholders only — real values belong in your local .env / host env.
# =============================================================================

# ===== TRADING SAFETY LOCKS (do not weaken) ================================
# simulation = paper broker, synthetic market   |   demo = broker demo account
# There is intentionally NO "live" value in this codebase.
TRADING_MODE=simulation
# Must stay false. The settings validator refuses to start if true.
ALLOW_LIVE_TRADING=false
# paper = synthetic broker (no credentials needed) | exness = official Exness API | mt5 = MetaTrader5 fallback (Windows host)
BROKER=paper
# Required true when BROKER=exness (demo-only restriction enforced in code).
EXN_ACCOUNT_IS_DEMO=true

# ===== MARKET / ENGINE ======================================================
# JSON array format.
INSTRUMENTS=["EURUSD", "GBPUSD", "XAUUSD"]
BAR_TIMEFRAMES_S=[5, 10, 60]
TICK_INTERVAL_MS=250
ACCOUNT_SNAPSHOT_INTERVAL_S=30
HEARTBEAT_INTERVAL_S=5

# ===== PAPER BROKER (synthetic market, development only) ===================
PAPER_START_BALANCE=10000
PAPER_LEVERAGE=200
PAPER_SLIPPAGE_BPS=0
PAPER_ACK_DELAY_S=0.05
PAPER_RANDOM_SEED=42

# ===== API SERVER ===========================================================
API_HOST=0.0.0.0
API_PORT=8000
# Bearer token required by the dashboard on /api/v1/* and /ws when set.
# Generate e.g.: openssl rand -hex 32
API_TOKEN=change-me-64-hex-chars
CORS_ORIGINS=["http://localhost:3000"]

# ===== DATABASE =============================================================
# Local development (SQLite, zero setup):
DATABASE_URL=sqlite+aiosqlite:///./data/dev.db
# Production (docker compose / VPS Postgres):
# DATABASE_URL=postgresql+asyncpg://trading:trading@localhost:5432/tradingbot

# ===== EXNESS API (Phase 10) ================================================
# Values come from Exness Personal Area > Key Management.
# API key is public (EXN-API-KEY header); the private key signs requests and
# must never leave the worker host.
EXN_API_KEY=
EXN_PRIVATE_KEY=
EXN_ACCOUNT_ID=
EXN_API_BASE_URL=https://api.exness.com

# ===== MT5 FALLBACK (only on a Windows host, Phase 10) =====================
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# ===== LLM ANALYSIS (optional, advisory only — risk service has final say) =
# Any OpenAI-compatible endpoint (base URL + key + model name).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=10

# ===== FRONTEND (Vercel project env vars) ===================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_TOKEN=
