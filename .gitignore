# --- Environment ---
.venv/
venv/
env/
.conda/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Testing / linting ---
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/

# --- Secrets: NEVER commit these ---
.env
*.key
*.pem
secrets.yaml
credentials.json

# --- Runtime state ---
*.log
logs/
state/
*.sqlite
*.db

# --- Market data (large, machine specific) ---
data/*.csv
data/*.parquet
!data/.gitkeep

# --- Generated reports/charts ---
# Everything under results/ is regenerated by `python run.py backtest`; the
# README quotes the numbers instead of committing the artifacts.
results/*
!results/.gitkeep

# --- OS / editors ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
